# Server port
PORT=3000

# JWT secret — change this!
JWT_SECRET=your-super-secret-key-change-in-production

# WebRTC settings
WEBRTC_MIN_PORT=40000
WEBRTC_MAX_PORT=40100

# Logging
LOG_LEVEL=warn

# TURN server (optional, for NAT traversal)
# TURN_HOST=localhost
# TURN_PORT=3478
# TURN_USERNAME=remote-user
# TURN_PASSWORD=changeme
